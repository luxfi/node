FROM golang:1.26.5-alpine AS builder

# The golang images set GOTOOLCHAIN=local, which turns a go.mod `go` directive
# newer than this base into a hard build failure. `auto` lets go fetch the
# required toolchain (checksum-verified via sum.golang.org) instead.
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git make gcc musl-dev linux-headers bash

WORKDIR /build

COPY . .

RUN ./scripts/build.sh

FROM alpine:latest

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/build/luxd /usr/local/bin/luxd

RUN adduser -D -h /app luxd
USER luxd
WORKDIR /app

EXPOSE 9650 9651

ENTRYPOINT ["/usr/local/bin/luxd"]