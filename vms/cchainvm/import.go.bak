)

const (
	// SubnetEVM namespace prefix length
	namespacePrefixLen = 32

	// Batch processing parameters
	defaultBatchSize = 1000
	maxBatchSize     = 10000

	// Progress reporting intervals
	progressInterval = 10000
	commitInterval   = 5000

	// Database cache sizes
	dbCacheSize    = 1024 // MB
	dbHandles      = 1024
	trieCleanCache = 256  // MB
	trieDirtyCache = 256  // MB
)

// ImportConfig contains configuration for the import process
type ImportConfig struct {
	SourcePath      string
	TargetPath      string
	StartBlock      uint64
	EndBlock        uint64
	BatchSize       int
	Workers         int
	VerifyState     bool
	RebuildState    bool
	StripNamespace  bool
	ChainConfig     *params.ChainConfig
	TargetWallet    common.Address
}

// ImportStats tracks import statistics
type ImportStats struct {
	ProcessedBlocks  uint64
	ProcessedTxs     uint64
	ProcessedLogs    uint64
	StateNodes       uint64
	Errors           uint64
	StartTime        time.Time
	LastBlockTime    time.Time
	BytesProcessed   uint64
	CurrentBlock     uint64
	WalletBalance    *big.Int
	WalletNonce      uint64
}

// Importer handles the SubnetEVM to C-Chain import process
type Importer struct {
	config      *ImportConfig
	sourceDB    ethdb.Database
	targetDB    ethdb.Database
	stats       *ImportStats
	mu          sync.RWMutex
	ctx         context.Context
	cancel      context.CancelFunc
	blockchain  *core.BlockChain
	stateCache  state.Database
	genesis     *core.Genesis
}

// NewImporter creates a new importer instance
func NewImporter(config *ImportConfig) (*Importer, error) {
	if config.BatchSize == 0 {
		config.BatchSize = defaultBatchSize
	}
	if config.BatchSize > maxBatchSize {
		config.BatchSize = maxBatchSize
	}
	if config.Workers == 0 {
		config.Workers = 4
	}

	// Default to stripping namespace for SubnetEVM imports
	if config.StripNamespace {
		log.Info("Namespace stripping enabled for SubnetEVM database")
	}

	ctx, cancel := context.WithCancel(context.Background())

	return &Importer{
		config: config,
		stats: &ImportStats{
			StartTime:     time.Now(),
			WalletBalance: new(big.Int),
		},
		ctx:    ctx,
		cancel: cancel,
	}, nil
}

// stripNamespacePrefix removes the 32-byte namespace prefix from SubnetEVM keys
func stripNamespacePrefix(key []byte) []byte {
	if len(key) > namespacePrefixLen {
		// Check if this looks like a namespaced key
		// SubnetEVM namespace starts with 337fb73f...
		if bytes.HasPrefix(key, []byte{0x33, 0x7f, 0xb7, 0x3f}) {
			return key[namespacePrefixLen:]
		}
	}
	return key
}

// translateKey converts SubnetEVM key format to C-Chain format
func translateKey(key []byte) []byte {
	// Strip namespace if present
	key = stripNamespacePrefix(key)

	// Additional key translations if needed
	// SubnetEVM and C-Chain may have different key schemas

	return key
}

// openSourceDatabase opens the SubnetEVM database with proper configuration
func (imp *Importer) openSourceDatabase() error {
	log.Info("Opening source SubnetEVM database", "path", imp.config.SourcePath)

	// Open with Pebble for SubnetEVM compatibility
	pebbleOpts := &pebble.Options{
		Cache:                       pebble.NewCache(int64(dbCacheSize * 1024 * 1024)),
		MaxOpenFiles:                dbHandles,
		DisableWAL:                  false,
		ReadOnly:                    true,
		L0CompactionThreshold:       2,
		L0StopWritesThreshold:       1000,
		LBaseMaxBytes:               64 * 1024 * 1024,
		MemTableSize:                64 * 1024 * 1024,
		MemTableStopWritesThreshold: 4,
	}

	db, err := pebble.Open(imp.config.SourcePath, pebbleOpts)
	if err != nil {
		return fmt.Errorf("failed to open source database: %w", err)
	}

	// Wrap in ethdb interface with namespace handling
	imp.sourceDB = &namespacedDB{
		db:             &pebbleDB{db: db},
		stripNamespace: imp.config.StripNamespace,
	}

	return nil
}

// namespacedDB wraps a database to handle namespace prefixes
type namespacedDB struct {
	db             ethdb.Database
	stripNamespace bool
}

func (n *namespacedDB) Has(key []byte) (bool, error) {
	if n.stripNamespace {
		key = translateKey(key)
	}
	return n.db.Has(key)
}

func (n *namespacedDB) Get(key []byte) ([]byte, error) {
	if n.stripNamespace {
		key = translateKey(key)
	}
	return n.db.Get(key)
}

func (n *namespacedDB) Put(key []byte, value []byte) error {
	if n.stripNamespace {
		key = translateKey(key)
	}
	return n.db.Put(key, value)
}

func (n *namespacedDB) Delete(key []byte) error {
	if n.stripNamespace {
		key = translateKey(key)
	}
	return n.db.Delete(key)
}

func (n *namespacedDB) NewBatch() ethdb.Batch {
	return &namespacedBatch{
		batch:          n.db.NewBatch(),
		stripNamespace: n.stripNamespace,
	}
}

func (n *namespacedDB) NewBatchWithSize(size int) ethdb.Batch {
	return &namespacedBatch{
		batch:          n.db.NewBatchWithSize(size),
		stripNamespace: n.stripNamespace,
	}
}

func (n *namespacedDB) NewIterator(prefix []byte, start []byte) ethdb.Iterator {
	if n.stripNamespace {
		prefix = translateKey(prefix)
		start = translateKey(start)
	}
	return &namespacedIterator{
		iter:           n.db.NewIterator(prefix, start),
		stripNamespace: n.stripNamespace,
	}
}

func (n *namespacedDB) Stat(property string) (string, error) {
	return n.db.Stat(property)
}

func (n *namespacedDB) Compact(start []byte, limit []byte) error {
	if n.stripNamespace {
		start = translateKey(start)
		limit = translateKey(limit)
	}
	return n.db.Compact(start, limit)
}

func (n *namespacedDB) NewSnapshot() (ethdb.Snapshot, error) {
	return n.db.NewSnapshot()
}

func (n *namespacedDB) Close() error {
	return n.db.Close()
}

// namespacedBatch handles batch operations with namespace stripping
type namespacedBatch struct {
	batch          ethdb.Batch
	stripNamespace bool
}

func (b *namespacedBatch) Put(key []byte, value []byte) error {
	if b.stripNamespace {
		key = translateKey(key)
	}
	return b.batch.Put(key, value)
}

func (b *namespacedBatch) Delete(key []byte) error {
	if b.stripNamespace {
		key = translateKey(key)
	}
	return b.batch.Delete(key)
}

func (b *namespacedBatch) ValueSize() int {
	return b.batch.ValueSize()
}

func (b *namespacedBatch) Write() error {
	return b.batch.Write()
}

func (b *namespacedBatch) Reset() {
	b.batch.Reset()
}

func (b *namespacedBatch) Replay(w ethdb.KeyValueWriter) error {
	return b.batch.Replay(w)
}

// namespacedIterator handles iteration with namespace stripping
type namespacedIterator struct {
	iter           ethdb.Iterator
	stripNamespace bool
}

func (i *namespacedIterator) Next() bool {
	return i.iter.Next()
}

func (i *namespacedIterator) Error() error {
	return i.iter.Error()
}

func (i *namespacedIterator) Key() []byte {
	key := i.iter.Key()
	if i.stripNamespace {
		return translateKey(key)
	}
	return key
}

func (i *namespacedIterator) Value() []byte {
	return i.iter.Value()
}

func (i *namespacedIterator) Release() {
	i.iter.Release()
}

// pebbleDB wraps pebble.DB to implement ethdb.Database
type pebbleDB struct {
	db *pebble.DB
}

func (p *pebbleDB) Has(key []byte) (bool, error) {
	val, closer, err := p.db.Get(key)
	if err == pebble.ErrNotFound {
		return false, nil
	}
	if err != nil {
		return false, err
	}
	closer.Close()
	return val != nil, nil
}

func (p *pebbleDB) Get(key []byte) ([]byte, error) {
	val, closer, err := p.db.Get(key)
	if err == pebble.ErrNotFound {
		return nil, ethdb.ErrNotFound
	}
	if err != nil {
		return nil, err
	}
	defer closer.Close()

	result := make([]byte, len(val))
	copy(result, val)
	return result, nil
}

func (p *pebbleDB) Put(key []byte, value []byte) error {
	return p.db.Set(key, value, pebble.Sync)
}

func (p *pebbleDB) Delete(key []byte) error {
	return p.db.Delete(key, pebble.Sync)
}

func (p *pebbleDB) NewBatch() ethdb.Batch {
	return &pebbleBatch{
		db:    p.db,
		batch: p.db.NewBatch(),
	}
}

func (p *pebbleDB) NewBatchWithSize(size int) ethdb.Batch {
	return &pebbleBatch{
		db:    p.db,
		batch: p.db.NewBatch(),
	}
}

func (p *pebbleDB) NewIterator(prefix []byte, start []byte) ethdb.Iterator {
	opts := &pebble.IterOptions{
		LowerBound: start,
	}
	if len(prefix) > 0 {
		opts.LowerBound = prefix
		opts.UpperBound = append(prefix, 0xff)
	}
	return &pebbleIterator{
		iter: p.db.NewIter(opts),
	}
}

func (p *pebbleDB) Stat(property string) (string, error) {
	return "", nil
}

func (p *pebbleDB) Compact(start []byte, limit []byte) error {
	return p.db.Compact(start, limit, true)
}

func (p *pebbleDB) NewSnapshot() (ethdb.Snapshot, error) {
	return p.db.NewSnapshot(), nil
}

func (p *pebbleDB) Close() error {
	return p.db.Close()
}

// pebbleBatch implements ethdb.Batch
type pebbleBatch struct {
	db    *pebble.DB
	batch *pebble.Batch
	size  int
}

func (b *pebbleBatch) Put(key []byte, value []byte) error {
	b.batch.Set(key, value, nil)
	b.size += len(key) + len(value)
	return nil
}

func (b *pebbleBatch) Delete(key []byte) error {
	b.batch.Delete(key, nil)
	b.size += len(key)
	return nil
}

func (b *pebbleBatch) ValueSize() int {
	return b.size
}

func (b *pebbleBatch) Write() error {
	return b.batch.Commit(pebble.Sync)
}

func (b *pebbleBatch) Reset() {
	b.batch.Reset()
	b.size = 0
}

func (b *pebbleBatch) Replay(w ethdb.KeyValueWriter) error {
	// Not efficiently implementable with Pebble
	return nil
}

// pebbleIterator implements ethdb.Iterator
type pebbleIterator struct {
	iter  *pebble.Iterator
	moved bool
}

func (i *pebbleIterator) Next() bool {
	if !i.moved {
		i.moved = true
		return i.iter.First()
	}
	return i.iter.Next()
}

func (i *pebbleIterator) Error() error {
	return i.iter.Error()
}

func (i *pebbleIterator) Key() []byte {
	return i.iter.Key()
}

func (i *pebbleIterator) Value() []byte {
	return i.iter.Value()
}

func (i *pebbleIterator) Release() {
	i.iter.Close()
}

// openTargetDatabase opens the C-Chain target database
func (imp *Importer) openTargetDatabase() error {
	log.Info("Opening target C-Chain database", "path", imp.config.TargetPath)

	var err error
	imp.targetDB, err = rawdb.NewLevelDBDatabase(imp.config.TargetPath, dbCacheSize, dbHandles, "", false)
	if err != nil {
		return fmt.Errorf("failed to open target database: %w", err)
	}

	return nil
}

// initializeBlockchain sets up the blockchain instance for processing
func (imp *Importer) initializeBlockchain() error {
	// Set up genesis if not present
	genesis := imp.genesis
	if genesis == nil {
		genesis = &core.Genesis{
			Config:     imp.config.ChainConfig,
			Timestamp:  1638360000,
			ExtraData:  []byte("LUX C-Chain Genesis"),
			GasLimit:   8000000,
			Difficulty: big.NewInt(1),
			Alloc:      make(core.GenesisAlloc),
		}

		// Add target wallet if specified
		if imp.config.TargetWallet != (common.Address{}) {
			genesis.Alloc[imp.config.TargetWallet] = core.GenesisAccount{
				Balance: new(big.Int).Mul(big.NewInt(1000000), big.NewInt(1e18)),
			}
		}
	}

	// Initialize state cache
	imp.stateCache = state.NewDatabaseWithConfig(imp.targetDB, &trie.Config{
		Cache:     trieCleanCache,
		Preimages: true,
	})

	// Create blockchain instance
	bcConfig := &core.CacheConfig{
		TrieCleanLimit:      trieCleanCache,
		TrieDirtyLimit:      trieDirtyCache,
		TrieTimeLimit:       5 * time.Minute,
		SnapshotLimit:       256,
		Preimages:           true,
		StateHistory:        90,
		StateScheme:         rawdb.HashScheme,
	}

	var err error
	imp.blockchain, err = core.NewBlockChain(imp.targetDB, bcConfig, genesis, nil, nil, nil, nil, nil)
	if err != nil {
		return fmt.Errorf("failed to create blockchain: %w", err)
	}

	return nil
}

// processBlocks processes blocks in batches
func (imp *Importer) processBlocks() error {
	log.Info("Starting block processing",
		"start", imp.config.StartBlock,
		"end", imp.config.EndBlock,
		"batch", imp.config.BatchSize,
	)

	batch := imp.targetDB.NewBatch()
	batchCount := 0

	for blockNum := imp.config.StartBlock; blockNum <= imp.config.EndBlock; blockNum++ {
		select {
		case <-imp.ctx.Done():
			return imp.ctx.Err()
		default:
		}

		// Read block from source
		blockHash := rawdb.ReadCanonicalHash(imp.sourceDB, blockNum)
		if blockHash == (common.Hash{}) {
			log.Warn("Missing canonical hash", "block", blockNum)
			continue
		}

		block := rawdb.ReadBlock(imp.sourceDB, blockHash, blockNum)
		if block == nil {
			log.Warn("Missing block", "number", blockNum, "hash", blockHash)
			continue
		}

		// Process the block
		if err := imp.processBlock(block, batch); err != nil {
			log.Error("Failed to process block", "number", blockNum, "error", err)
			atomic.AddUint64(&imp.stats.Errors, 1)
			continue
		}

		atomic.StoreUint64(&imp.stats.CurrentBlock, blockNum)
		atomic.AddUint64(&imp.stats.ProcessedBlocks, 1)
		atomic.AddUint64(&imp.stats.ProcessedTxs, uint64(len(block.Transactions())))

		batchCount++

		// Commit batch if needed
		if batchCount >= imp.config.BatchSize {
			if err := batch.Write(); err != nil {
				return fmt.Errorf("failed to write batch: %w", err)
			}
			batch.Reset()
			batchCount = 0

			// Report progress
			if blockNum%progressInterval == 0 {
				imp.reportProgress()
			}
		}

		// Check wallet balance if specified
		if imp.config.TargetWallet != (common.Address{}) && blockNum%commitInterval == 0 {
			imp.checkWalletState(block.Root())
		}
	}

	// Write final batch
	if batchCount > 0 {
		if err := batch.Write(); err != nil {
			return fmt.Errorf("failed to write final batch: %w", err)
		}
	}

	return nil
}

// processBlock processes a single block
func (imp *Importer) processBlock(block *types.Block, batch ethdb.Batch) error {
	// Write block header
	rawdb.WriteHeader(batch, block.Header())
	rawdb.WriteCanonicalHash(batch, block.Hash(), block.NumberU64())

	// Write block body
	rawdb.WriteBody(batch, block.Hash(), block.NumberU64(), block.Body())

	// Write receipts if available
	receipts := rawdb.ReadReceipts(imp.sourceDB, block.Hash(), block.NumberU64(), block.Time(), imp.config.ChainConfig)
	if receipts != nil {
		rawdb.WriteReceipts(batch, block.Hash(), block.NumberU64(), receipts)

		// Count logs
		for _, receipt := range receipts {
			atomic.AddUint64(&imp.stats.ProcessedLogs, uint64(len(receipt.Logs)))
		}
	}

	// Process state if rebuilding
	if imp.config.RebuildState {
		if err := imp.processState(block, batch); err != nil {
			return fmt.Errorf("failed to process state: %w", err)
		}
	}

	// Write TD (total difficulty)
	td := rawdb.ReadTd(imp.sourceDB, block.Hash(), block.NumberU64())
	if td != nil {
		rawdb.WriteTd(batch, block.Hash(), block.NumberU64(), td)
	}

	return nil
}

// processState rebuilds state for a block
func (imp *Importer) processState(block *types.Block, batch ethdb.Batch) error {
	// Get parent state
	var parentRoot common.Hash
	if block.NumberU64() > 0 {
		parentHash := rawdb.ReadCanonicalHash(imp.targetDB, block.NumberU64()-1)
		parentHeader := rawdb.ReadHeader(imp.targetDB, parentHash, block.NumberU64()-1)
		if parentHeader != nil {
			parentRoot = parentHeader.Root
		}
	}

	// Open state trie
	stateDB, err := state.New(parentRoot, imp.stateCache, nil)
	if err != nil {
		// If parent state is missing, try to read from source
		stateDB, err = imp.readSourceState(block.Root())
		if err != nil {
			return fmt.Errorf("failed to open state: %w", err)
		}
	}

	// Process transactions to update state
	gp := new(core.GasPool).AddGas(block.GasLimit())
	usedGas := uint64(0)

	for _, tx := range block.Transactions() {
		receipt, err := imp.applyTransaction(stateDB, block.Header(), tx, gp, &usedGas)
		if err != nil {
			log.Warn("Failed to apply transaction", "tx", tx.Hash(), "error", err)
			continue
		}

		// Track wallet activity
		if imp.config.TargetWallet != (common.Address{}) {
			imp.trackWalletActivity(tx, receipt)
		}
	}

	// Commit state
	root, err := stateDB.Commit(block.NumberU64(), true)
	if err != nil {
		return fmt.Errorf("failed to commit state: %w", err)
	}

	// Verify state root if requested
	if imp.config.VerifyState && root != block.Root() {
		return fmt.Errorf("state root mismatch: got %x, want %x", root, block.Root())
	}

	// Write state to batch
	stateDB.Database().TrieDB().Commit(root, false)

	atomic.AddUint64(&imp.stats.StateNodes, 1)

	return nil
}

// readSourceState reads state from source database
func (imp *Importer) readSourceState(root common.Hash) (*state.StateDB, error) {
	// Create temporary state database for reading source state
	tempCache := state.NewDatabaseWithConfig(imp.sourceDB, &trie.Config{
		Cache:     128,
		Preimages: true,
	})

	return state.New(root, tempCache, nil)
}

// applyTransaction applies a transaction to the state
func (imp *Importer) applyTransaction(stateDB *state.StateDB, header *types.Header, tx *types.Transaction, gp *core.GasPool, usedGas *uint64) (*types.Receipt, error) {
	msg, err := core.TransactionToMessage(tx, types.LatestSignerForChainID(imp.config.ChainConfig.ChainID), header.BaseFee)
	if err != nil {
		return nil, err
	}

	// Create EVM
	blockContext := core.NewEVMBlockContext(header, imp.blockchain, nil)
	vmenv := core.NewEVM(blockContext, core.NewEVMTxContext(msg), stateDB, imp.config.ChainConfig, core.Config{})

	// Apply the transaction
	result, err := core.ApplyMessage(vmenv, msg, gp)
	if err != nil {
		return nil, err
	}

	*usedGas += result.UsedGas

	// Create receipt
	receipt := &types.Receipt{
		Type:              tx.Type(),
		PostState:         nil,
		Status:            result.Status(),
		CumulativeGasUsed: *usedGas,
		Bloom:             types.CreateBloom(types.Receipts{&types.Receipt{Logs: stateDB.GetLogs(tx.Hash(), header.Number.Uint64(), header.Hash())}}),
		Logs:              stateDB.GetLogs(tx.Hash(), header.Number.Uint64(), header.Hash()),
		TxHash:            tx.Hash(),
		ContractAddress:   result.ContractAddress,
		GasUsed:           result.UsedGas,
		BlockHash:         header.Hash(),
		BlockNumber:       header.Number,
		TransactionIndex:  uint(len(stateDB.GetLogs(tx.Hash(), header.Number.Uint64(), header.Hash()))),
	}

	return receipt, nil
}

// trackWalletActivity tracks wallet transactions
func (imp *Importer) trackWalletActivity(tx *types.Transaction, receipt *types.Receipt) {
	if receipt.Status != types.ReceiptStatusSuccessful {
		return
	}

	// Check if wallet is involved
	from, _ := types.Sender(types.LatestSignerForChainID(imp.config.ChainConfig.ChainID), tx)
	to := tx.To()

	isInvolved := from == imp.config.TargetWallet
	if to != nil && *to == imp.config.TargetWallet {
		isInvolved = true
	}

	if isInvolved {
		log.Info("Wallet activity detected",
			"block", receipt.BlockNumber,
			"tx", tx.Hash(),
			"from", from,
			"to", to,
			"value", tx.Value(),
		)
	}
}

// checkWalletState checks the wallet balance and nonce
func (imp *Importer) checkWalletState(stateRoot common.Hash) {
	if imp.config.TargetWallet == (common.Address{}) {
		return
	}

	stateDB, err := state.New(stateRoot, imp.stateCache, nil)
	if err != nil {
		log.Warn("Failed to open state for wallet check", "error", err)
		return
	}

	balance := stateDB.GetBalance(imp.config.TargetWallet)
	nonce := stateDB.GetNonce(imp.config.TargetWallet)

	imp.mu.Lock()
	imp.stats.WalletBalance = balance.ToBig()
	imp.stats.WalletNonce = nonce
	imp.mu.Unlock()

	log.Info("Wallet state",
		"address", imp.config.TargetWallet,
		"balance", balance.String(),
		"nonce", nonce,
	)
}

// reportProgress reports import progress
func (imp *Importer) reportProgress() {
	imp.mu.RLock()
	stats := *imp.stats
	imp.mu.RUnlock()

	elapsed := time.Since(stats.StartTime)
	blocksPerSec := float64(stats.ProcessedBlocks) / elapsed.Seconds()
	remaining := imp.config.EndBlock - stats.CurrentBlock
	eta := time.Duration(float64(remaining) / blocksPerSec * float64(time.Second))

	log.Info("Import progress",
		"current", stats.CurrentBlock,
		"target", imp.config.EndBlock,
		"processed", stats.ProcessedBlocks,
		"txs", stats.ProcessedTxs,
		"logs", stats.ProcessedLogs,
		"state", stats.StateNodes,
		"errors", stats.Errors,
		"blocks/sec", fmt.Sprintf("%.2f", blocksPerSec),
		"eta", eta.String(),
	)

	if imp.config.TargetWallet != (common.Address{}) {
		log.Info("Wallet status",
			"address", imp.config.TargetWallet,
			"balance", stats.WalletBalance.String(),
			"nonce", stats.WalletNonce,
		)
	}
}

// Run executes the import process
func (imp *Importer) Run() error {
	log.Info("Starting SubnetEVM to C-Chain import",
		"source", imp.config.SourcePath,
		"target", imp.config.TargetPath,
		"start", imp.config.StartBlock,
		"end", imp.config.EndBlock,
		"strip_namespace", imp.config.StripNamespace,
		"rebuild_state", imp.config.RebuildState,
		"verify_state", imp.config.VerifyState,
	)

	// Open databases
	if err := imp.openSourceDatabase(); err != nil {
		return err
	}
	defer imp.sourceDB.Close()

	if err := imp.openTargetDatabase(); err != nil {
		return err
	}
	defer imp.targetDB.Close()

	// Initialize blockchain
	if err := imp.initializeBlockchain(); err != nil {
		return err
	}
	defer imp.blockchain.Stop()

	// Process blocks
	if err := imp.processBlocks(); err != nil {
		return err
	}

	// Final report
	imp.reportProgress()

	log.Info("Import completed successfully",
		"blocks", imp.stats.ProcessedBlocks,
		"txs", imp.stats.ProcessedTxs,
		"errors", imp.stats.Errors,
		"duration", time.Since(imp.stats.StartTime),
	)

	return nil
}

// ImportSubnetEVM is the main entry point for importing SubnetEVM data
func ImportSubnetEVM(sourcePath, targetPath string, targetHeight uint64, targetWallet string) error {
	// Parse wallet address
	var wallet common.Address
	if targetWallet != "" {
		wallet = common.HexToAddress(targetWallet)
	}

	// Create import configuration
	config := &ImportConfig{
		SourcePath:     sourcePath,
		TargetPath:     targetPath,
		StartBlock:     0,
		EndBlock:       targetHeight,
		BatchSize:      defaultBatchSize,
		Workers:        4,
		VerifyState:    false, // Set to true for verification
		RebuildState:   true,
		StripNamespace: true,  // Required for SubnetEVM
		ChainConfig: &params.ChainConfig{
			ChainID:             big.NewInt(96369),
			HomesteadBlock:      big.NewInt(0),
			EIP150Block:         big.NewInt(0),
			EIP155Block:         big.NewInt(0),
			EIP158Block:         big.NewInt(0),
			ByzantiumBlock:      big.NewInt(0),
			ConstantinopleBlock: big.NewInt(0),
			PetersburgBlock:     big.NewInt(0),
			IstanbulBlock:       big.NewInt(0),
			BerlinBlock:         big.NewInt(0),
			LondonBlock:         big.NewInt(0),
			ShanghaiTime:        new(uint64),
			CancunTime:          new(uint64),
			Ethash:              &params.EthashConfig{},
		},
		TargetWallet: wallet,
	}

	// Create and run importer
	importer, err := NewImporter(config)
	if err != nil {
		return err
	}

	return importer.Run()
}

// Command-line interface for standalone usage
func RunImportCLI(args []string) {
	if len(args) < 3 {
		fmt.Println("Usage: import <source_path> <target_path> <target_height> [wallet_address]")
		return
	}

	sourcePath := args[0]
	targetPath := args[1]

	targetHeight, err := parseUint64(args[2])
	if err != nil {
		log.Error("Invalid target height", "error", err)
		return
	}

	wallet := ""
	if len(args) > 3 {
		wallet = args[3]
	}

	if err := ImportSubnetEVM(sourcePath, targetPath, targetHeight, wallet); err != nil {
		log.Error("Import failed", "error", err)
	}
}

func parseUint64(s string) (uint64, error) {
	var val uint64
	_, err := fmt.Sscanf(s, "%d", &val)
	return val, err
}