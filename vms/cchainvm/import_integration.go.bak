// ImportSubnetEVMDatabaseStandalone runs import without VM dependency
func ImportSubnetEVMDatabaseStandalone(sourcePath, targetPath string, targetHeight uint64, targetWallet string) error {
	log.Info("Starting SubnetEVM database import (standalone)",
		"source", sourcePath,
		"target", targetPath,
		"height", targetHeight,
	)

	// Parse wallet address
	var wallet common.Address
	if targetWallet != "" {
		wallet = common.HexToAddress(targetWallet)
	}

	// Create import configuration
	config := &ImportConfig{
		SourcePath:     sourcePath,
		TargetPath:     targetPath,
		StartBlock:     0,
		EndBlock:       targetHeight,
		BatchSize:      1000,
		Workers:        4,
		VerifyState:    false,
		RebuildState:   true,
		StripNamespace: true,
		TargetWallet:   wallet,
		ChainConfig:    GetDefaultChainConfig(), // Use default config for standalone
	}

	// Create importer
	importer, err := NewImporter(config)
	if err != nil {
		return err
	}

	// Run the import
	return importer.Run()
}

// ImportStatus provides import progress information
type ImportStatus struct {
	Running         bool   `json:"running"`
	CurrentBlock    uint64 `json:"current_block"`
	TargetBlock     uint64 `json:"target_block"`
	ProcessedBlocks uint64 `json:"processed_blocks"`
	ProcessedTxs    uint64 `json:"processed_txs"`
	Errors          uint64 `json:"errors"`
	ElapsedTime     string `json:"elapsed_time"`
	ETA             string `json:"eta"`
}