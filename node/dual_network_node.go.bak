package node

import (
	"fmt"
	"path/filepath"
	"sync"

	"github.com/luxfi/node/chains"
	"github.com/luxfi/node/config"
	"github.com/luxfi/node/database"
	"github.com/luxfi/node/database/factory"
	"github.com/luxfi/node/ids"
	"github.com/luxfi/node/nodevalidators"
	"github.com/luxfi/node/version"
)

// DualNetworkNode extends Node to support both mainnet and testnet simultaneously
type DualNetworkNode struct {
	*Node // Embed the original Node

	// Primary network (mainnet)
	MainnetContext *NetworkContext

	// Secondary network (testnet)
	TestnetContext *NetworkContext

	// Shared components
	sharedRouter Router

	// Mutex for thread safety
	mu sync.RWMutex
}

// InitializeDualNetworks sets up both mainnet and testnet
func (n *DualNetworkNode) InitializeDualNetworks() error {
	n.Log.Info("Initializing dual-network support for Mainnet and Testnet")

	// Initialize Mainnet (96369)
	mainnetCtx, err := n.initializeNetwork(96369, "mainnet", 9630, 9631)
	if err != nil {
		return fmt.Errorf("failed to initialize mainnet: %w", err)
	}
	n.MainnetContext = mainnetCtx

	// Initialize Testnet (96368)
	testnetCtx, err := n.initializeNetwork(96368, "testnet", 9620, 9621)
	if err != nil {
		return fmt.Errorf("failed to initialize testnet: %w", err)
	}
	n.TestnetContext = testnetCtx

	n.Log.Info("Successfully initialized dual-network support",
		"mainnet", 96369,
		"testnet", 96368,
	)

	return nil
}

// initializeNetwork creates a network context for a specific network
func (n *DualNetworkNode) initializeNetwork(networkID uint32, name string, httpPort, stakingPort int) (*NetworkContext, error) {
	n.Log.Info("Initializing network",
		"networkID", networkID,
		"name", name,
		"httpPort", httpPort,
		"stakingPort", stakingPort,
	)

	// Create network-specific paths
	networkPath := filepath.Join(n.Config.DatabaseConfig.Path, fmt.Sprintf("network-%d", networkID))
	chainDataDir := filepath.Join(n.Config.ChainDataDir, fmt.Sprintf("network-%d", networkID))

	// Initialize network-specific database
	dbPath := filepath.Join(networkPath, version.CurrentDatabase.String())
	if n.Config.DatabaseConfig.Name == "badgerdb" {
		dbPath = filepath.Join(networkPath, "badger")
	}

	db, err := factory.New(
		n.Config.DatabaseConfig.Name,
		dbPath,
		n.Config.ReadOnly,
		nil,
		n.MeterDBMetricsGatherer,
		n.Log,
		fmt.Sprintf("db-%d", networkID),
		"all",
	)
	if err != nil {
		return nil, fmt.Errorf("failed to create database for network %d: %w", networkID, err)
	}

	// Create network-specific validators manager
	validators := nodevalidators.NewManager()

	// Create network-specific bootstrappers
	bootstrappers := nodevalidators.NewManager()

	// Create network context
	ctx := &NetworkContext{
		NetworkID:     networkID,
		Database:      db,
		Validators:    validators,
		Bootstrappers: bootstrappers,
		ChainDataDir:  chainDataDir,
		Active:        true,
	}

	// Initialize subnets for this network
	// Mainnet has Zoo, Hanzo, SPC as subnets
	// Testnet has their test versions
	if err := n.initializeSubnets(ctx); err != nil {
		return nil, fmt.Errorf("failed to initialize subnets for network %d: %w", networkID, err)
	}

	return ctx, nil
}

// initializeSubnets sets up L1s/L2s (subnets) for a network
func (n *DualNetworkNode) initializeSubnets(ctx *NetworkContext) error {
	switch ctx.NetworkID {
	case 96369: // Mainnet
		n.Log.Info("Initializing mainnet subnets: Zoo, Hanzo, SPC")
		// These would be initialized via subnet creation transactions on P-Chain
		// They're not separate networks but chains within this network

	case 96368: // Testnet
		n.Log.Info("Initializing testnet subnets: Zoo-test, Hanzo-test, SPC-test")
		// Test versions of the subnets
	}

	return nil
}

// GetNetworkRPC returns the RPC endpoint for a specific network or subnet
func (n *DualNetworkNode) GetNetworkRPC(networkID uint32, chain string) (string, error) {
	n.mu.RLock()
	defer n.mu.RUnlock()

	var port int
	switch networkID {
	case 96369:
		port = 9630
	case 96368:
		port = 9620
	default:
		// Check if it's a subnet ID
		// Subnets are accessed through their parent network
		return "", fmt.Errorf("unknown network ID: %d", networkID)
	}

	// Build RPC path based on chain
	switch chain {
	case "P":
		return fmt.Sprintf("http://localhost:%d/ext/P", port), nil
	case "X":
		return fmt.Sprintf("http://localhost:%d/ext/X", port), nil
	case "C":
		return fmt.Sprintf("http://localhost:%d/ext/bc/C/rpc", port), nil
	default:
		// Could be a subnet chain ID
		return fmt.Sprintf("http://localhost:%d/ext/bc/%s/rpc", port, chain), nil
	}
}

// GetSubnetInfo returns information about subnets on a network
func (n *DualNetworkNode) GetSubnetInfo(networkID uint32) (map[string]interface{}, error) {
	n.mu.RLock()
	defer n.mu.RUnlock()

	var ctx *NetworkContext
	switch networkID {
	case 96369:
		ctx = n.MainnetContext
	case 96368:
		ctx = n.TestnetContext
	default:
		return nil, fmt.Errorf("unknown network ID: %d", networkID)
	}

	if ctx == nil {
		return nil, fmt.Errorf("network %d not initialized", networkID)
	}

	// In a real implementation, this would query the P-Chain
	// to get actual subnet information
	subnets := map[string]interface{}{
		"networkID":   networkID,
		"networkName": n.getNetworkName(networkID),
		"subnets":     n.getSubnetsForNetwork(networkID),
	}

	return subnets, nil
}

// getNetworkName returns the name of a network
func (n *DualNetworkNode) getNetworkName(networkID uint32) string {
	switch networkID {
	case 96369:
		return "Lux Mainnet"
	case 96368:
		return "Lux Testnet"
	default:
		return fmt.Sprintf("Unknown (%d)", networkID)
	}
}

