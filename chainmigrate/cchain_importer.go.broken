package chainmigrate

import (
	"context"
	"fmt"
	"math/big"
	"sync"

	"github.com/luxfi/geth/common"
	"github.com/luxfi/geth/core"
	"github.com/luxfi/geth/core/rawdb"
	"github.com/luxfi/geth/core/state"
	"github.com/luxfi/geth/core/types"
	"github.com/luxfi/geth/core/vm"
	"github.com/luxfi/geth/crypto"
	"github.com/luxfi/geth/ethdb"
	"github.com/luxfi/geth/params"
	"github.com/luxfi/geth/rlp"
	"github.com/luxfi/geth/trie"
)

// CChainImporter imports blockchain data into C-Chain with CorethVM compatibility
type CChainImporter struct {
	config      ImporterConfig
	chainConfig *params.ChainConfig
	db          ethdb.Database
	stateDB     state.Database
	blockchain  *core.BlockChain
	genesis     *core.Genesis

	// CorethVM specific fields
	acceptedBlockDB ethdb.Database  // Separate DB for accepted blocks
	vmConfig        vm.Config

	// Import tracking
	importedBlocks uint64
	importedState  uint64
	mu             sync.RWMutex
}

// NewCChainImporter creates a new C-Chain importer
func NewCChainImporter(config ImporterConfig) *CChainImporter {
	return &CChainImporter{
		config:   config,
		vmConfig: vm.Config{},
	}
}

// Init initializes the C-Chain importer
func (i *CChainImporter) Init(config ImporterConfig) error {
	i.config = config

	// Open database
	db, err := i.openDatabase()
	if err != nil {
		return fmt.Errorf("failed to open database: %w", err)
	}
	i.db = db

	// Initialize state database with trie
	i.stateDB = state.NewDatabaseWithConfig(db, &trie.Config{
		Cache:     256,
		Journal:   "",
		Preimages: true,
	})

	// CorethVM specific: Initialize accepted block database if needed
	if i.config.EnableCorethCompat {
		acceptedDB, err := i.openAcceptedBlockDB()
		if err != nil {
			return fmt.Errorf("failed to open accepted block DB: %w", err)
		}
		i.acceptedBlockDB = acceptedDB
	}

	return nil
}

// ImportConfig imports chain configuration
func (i *CChainImporter) ImportConfig(config *ChainConfig) error {
	// Convert to go-ethereum chain config
	i.chainConfig = &params.ChainConfig{
		ChainID:             big.NewInt(int64(config.ChainID)),
		HomesteadBlock:      big.NewInt(0),
		EIP150Block:         big.NewInt(0),
		EIP155Block:         big.NewInt(0),
		EIP158Block:         big.NewInt(0),
		ByzantiumBlock:      big.NewInt(0),
		ConstantinopleBlock: big.NewInt(0),
		PetersburgBlock:     big.NewInt(0),
		IstanbulBlock:       big.NewInt(0),
		BerlinBlock:         big.NewInt(0),
		LondonBlock:         big.NewInt(0),
	}

	// Apply CorethVM specific configurations
	if i.config.EnableCorethCompat {
		i.applyCorethConfig(config)
	}

	// Create genesis block
	i.genesis = &core.Genesis{
		Config:     i.chainConfig,
		Timestamp:  config.GenesisTime,
		ExtraData:  config.GenesisExtra,
		GasLimit:   config.GasLimit,
		Difficulty: big.NewInt(0), // PoS/PoA
		Alloc:      make(core.GenesisAlloc),
	}

	// Add genesis allocations
	for addr, account := range config.GenesisAlloc {
		ethAddr := common.HexToAddress(addr)
		balance := new(big.Int)
		balance.SetString(account.Balance, 10)

		i.genesis.Alloc[ethAddr] = core.GenesisAccount{
			Balance: balance,
			Nonce:   account.Nonce,
			Code:    common.FromHex(account.Code),
			Storage: account.Storage,
		}
	}

	// Initialize blockchain
	return i.initBlockchain()
}

// ImportBlock imports a single block
func (i *CChainImporter) ImportBlock(block *BlockData) error {
	i.mu.Lock()
	defer i.mu.Unlock()

	// Decode block components
	header, err := i.decodeHeader(block.Header)
	if err != nil {
		return fmt.Errorf("failed to decode header: %w", err)
	}

	body, err := i.decodeBody(block.Body)
	if err != nil {
		return fmt.Errorf("failed to decode body: %w", err)
	}

	receipts, err := i.decodeReceipts(block.Receipts)
	if err != nil {
		return fmt.Errorf("failed to decode receipts: %w", err)
	}

	// Create block
	ethBlock := types.NewBlockWithHeader(header).WithBody(body.Transactions, body.Uncles)

	// CorethVM specific: Handle accepted blocks differently
	if i.config.EnableCorethCompat {
		return i.importCorethBlock(ethBlock, receipts)
	}

	// Standard import for C-Chain
	return i.importStandardBlock(ethBlock, receipts)
}

// ImportBlocks imports multiple blocks in batch
func (i *CChainImporter) ImportBlocks(blocks []*BlockData) error {
	for _, block := range blocks {
		if err := i.ImportBlock(block); err != nil {
			if i.config.ContinueOnError {
				fmt.Printf("Warning: failed to import block %d: %v\n", block.Number, err)
				continue
			}
			return err
		}
		i.importedBlocks++

		if i.importedBlocks%1000 == 0 {
			fmt.Printf("Imported %d blocks...\n", i.importedBlocks)
		}
	}
	return nil
}

// ImportState imports state at a specific block
func (i *CChainImporter) ImportState(accounts []*StateAccount, blockNumber uint64) error {
	i.mu.Lock()
	defer i.mu.Unlock()

	// Get state at block
	stateDB, err := i.blockchain.StateAt(i.blockchain.GetHeaderByNumber(blockNumber).Root)
	if err != nil {
		return fmt.Errorf("failed to get state at block %d: %w", blockNumber, err)
	}

	// Import accounts
	for _, account := range accounts {
		addr := common.HexToAddress(account.Address)

		// Set balance
		balance := new(big.Int)
		balance.SetString(account.Balance, 10)
		stateDB.SetBalance(addr, balance)

		// Set nonce
		stateDB.SetNonce(addr, account.Nonce)

		// Set code
		if len(account.Code) > 0 {
			stateDB.SetCode(addr, common.FromHex(account.Code))
		}

		// Set storage
		for key, value := range account.Storage {
			stateDB.SetState(addr, common.HexToHash(key), common.HexToHash(value))
		}
	}

	// Commit state changes
	root, err := stateDB.Commit(true)
	if err != nil {
		return fmt.Errorf("failed to commit state: %w", err)
	}

	// CorethVM specific: Update accepted state
	if i.config.EnableCorethCompat {
		i.updateCorethAcceptedState(root, blockNumber)
	}

	i.importedState++
	return nil
}

// FinalizeImport finalizes the import process
func (i *CChainImporter) FinalizeImport(blockNumber uint64) error {
	i.mu.Lock()
	defer i.mu.Unlock()

	// Set head block
	block := i.blockchain.GetBlockByNumber(blockNumber)
	if block == nil {
		return fmt.Errorf("block %d not found", blockNumber)
	}

	rawdb.WriteHeadBlockHash(i.db, block.Hash())
	rawdb.WriteHeadHeaderHash(i.db, block.Hash())

	// CorethVM specific: Mark as accepted
	if i.config.EnableCorethCompat {
		i.markBlockAccepted(block)
	}

	fmt.Printf("Finalized import at block %d\n", blockNumber)
	return nil
}

// VerifyImport verifies the imported data
func (i *CChainImporter) VerifyImport(blockNumber uint64) error {
	// Verify block exists
	block := i.blockchain.GetBlockByNumber(blockNumber)
	if block == nil {
		return fmt.Errorf("block %d not found", blockNumber)
	}

	// Verify state root
	stateDB, err := i.blockchain.StateAt(block.Root())
	if err != nil {
		return fmt.Errorf("failed to get state at block %d: %w", blockNumber, err)
	}

	root := stateDB.IntermediateRoot(false)
	if root != block.Root() {
		return fmt.Errorf("state root mismatch at block %d: expected %s, got %s",
			blockNumber, block.Root().Hex(), root.Hex())
	}

	// CorethVM specific: Verify accepted status
	if i.config.EnableCorethCompat {
		if !i.isBlockAccepted(block) {
			return fmt.Errorf("block %d not marked as accepted", blockNumber)
		}
	}

	return nil
}

// ExecuteBlock executes a block to rebuild state
func (i *CChainImporter) ExecuteBlock(block *BlockData) error {
	i.mu.Lock()
	defer i.mu.Unlock()

	// Decode block
	header, err := i.decodeHeader(block.Header)
	if err != nil {
		return fmt.Errorf("failed to decode header: %w", err)
	}

	body, err := i.decodeBody(block.Body)
	if err != nil {
		return fmt.Errorf("failed to decode body: %w", err)
	}

	ethBlock := types.NewBlockWithHeader(header).WithBody(body.Transactions, body.Uncles)

	// Get parent state
	parent := i.blockchain.GetBlock(ethBlock.ParentHash(), ethBlock.NumberU64()-1)
	if parent == nil {
		return fmt.Errorf("parent block not found")
	}

	stateDB, err := i.blockchain.StateAt(parent.Root())
	if err != nil {
		return fmt.Errorf("failed to get parent state: %w", err)
	}

	// Execute block
	receipts, _, usedGas, err := i.blockchain.Processor().Process(ethBlock, stateDB, i.vmConfig)
	if err != nil {
		return fmt.Errorf("failed to process block: %w", err)
	}

	// Validate state root
	root := stateDB.IntermediateRoot(i.chainConfig.IsEIP158(ethBlock.Number()))
	if root != ethBlock.Root() {
		return fmt.Errorf("state root mismatch after execution")
	}

	// Store block and receipts
	rawdb.WriteBlock(i.db, ethBlock)
	rawdb.WriteReceipts(i.db, ethBlock.Hash(), ethBlock.NumberU64(), receipts)

	// CorethVM specific: Handle consensus
	if i.config.EnableCorethCompat {
		i.handleCorethConsensus(ethBlock, receipts, usedGas)
	}

	return nil
}

// Close closes the importer
func (i *CChainImporter) Close() error {
	if i.blockchain != nil {
		i.blockchain.Stop()
	}

	if i.acceptedBlockDB != nil {
		i.acceptedBlockDB.Close()
	}

	if i.db != nil {
		return i.db.Close()
	}

	return nil
}

// Helper methods

func (i *CChainImporter) openDatabase() (ethdb.Database, error) {
	switch i.config.DatabaseType {
	case "leveldb":
		return rawdb.NewLevelDBDatabase(i.config.DatabasePath, 256, 256, "", false)
	case "pebble":
		return rawdb.NewPebbleDBDatabase(i.config.DatabasePath, 256, 256, "", false)
	default:
		return nil, fmt.Errorf("unsupported database type: %s", i.config.DatabaseType)
	}
}

func (i *CChainImporter) openAcceptedBlockDB() (ethdb.Database, error) {
	acceptedPath := i.config.DatabasePath + "/accepted"
	return rawdb.NewLevelDBDatabase(acceptedPath, 128, 128, "", false)
}

func (i *CChainImporter) initBlockchain() error {
	// Initialize genesis
	block := i.genesis.MustCommit(i.db)

	// Create blockchain
	blockchain, err := core.NewBlockChain(i.db, nil, i.chainConfig, nil, i.vmConfig, nil, nil)
	if err != nil {
		return fmt.Errorf("failed to create blockchain: %w", err)
	}

	i.blockchain = blockchain
	return nil
}

func (i *CChainImporter) decodeHeader(data []byte) (*types.Header, error) {
	var header types.Header
	if err := rlp.DecodeBytes(data, &header); err != nil {
		return nil, err
	}
	return &header, nil
}

func (i *CChainImporter) decodeBody(data []byte) (*types.Body, error) {
	var body types.Body
	if err := rlp.DecodeBytes(data, &body); err != nil {
		return nil, err
	}
	return &body, nil
}

func (i *CChainImporter) decodeReceipts(data []byte) (types.Receipts, error) {
	var receipts types.Receipts
	if err := rlp.DecodeBytes(data, &receipts); err != nil {
		return nil, err
	}
	return receipts, nil
}

func (i *CChainImporter) importStandardBlock(block *types.Block, receipts types.Receipts) error {
	// Write block to database
	rawdb.WriteBlock(i.db, block)
	rawdb.WriteReceipts(i.db, block.Hash(), block.NumberU64(), receipts)
	rawdb.WriteHeadBlockHash(i.db, block.Hash())

	return nil
}

// CorethVM specific methods

func (i *CChainImporter) applyCorethConfig(config *ChainConfig) {
	// Apply Coreth-specific chain config modifications
	// These handle differences in consensus and VM behavior

	// Enable Avalanche-specific EIPs
	if config.Extra != nil {
		if avaxConfig, ok := config.Extra["avalanche"].(map[string]interface{}); ok {
			// Apply Avalanche consensus rules
			if apricotPhase1, ok := avaxConfig["apricotPhase1BlockTimestamp"].(float64); ok {
				i.chainConfig.Extra = make(map[string]interface{})
				i.chainConfig.Extra["apricotPhase1BlockTimestamp"] = uint64(apricotPhase1)
			}
		}
	}
}

func (i *CChainImporter) importCorethBlock(block *types.Block, receipts types.Receipts) error {
	// Special handling for Coreth blocks
	// This includes consensus-specific validation and storage

	// Store in main database
	rawdb.WriteBlock(i.db, block)
	rawdb.WriteReceipts(i.db, block.Hash(), block.NumberU64(), receipts)

	// Store in accepted block database
	if i.acceptedBlockDB != nil {
		key := append([]byte("accepted:"), block.Hash().Bytes()...)
		value := []byte{1}
		i.acceptedBlockDB.Put(key, value)
	}

	// Update chain head
	rawdb.WriteHeadBlockHash(i.db, block.Hash())
	rawdb.WriteHeadHeaderHash(i.db, block.Hash())

	return nil
}

func (i *CChainImporter) updateCorethAcceptedState(root common.Hash, blockNumber uint64) {
	// Update accepted state in CorethVM
	if i.acceptedBlockDB != nil {
		key := []byte(fmt.Sprintf("acceptedState:%d", blockNumber))
		i.acceptedBlockDB.Put(key, root.Bytes())
	}
}

func (i *CChainImporter) markBlockAccepted(block *types.Block) {
	// Mark block as accepted in CorethVM
	if i.acceptedBlockDB != nil {
		key := append([]byte("accepted:"), block.Hash().Bytes()...)
		value := []byte{1}
		i.acceptedBlockDB.Put(key, value)
	}
}

func (i *CChainImporter) isBlockAccepted(block *types.Block) bool {
	// Check if block is accepted in CorethVM
	if i.acceptedBlockDB != nil {
		key := append([]byte("accepted:"), block.Hash().Bytes()...)
		value, err := i.acceptedBlockDB.Get(key)
		return err == nil && len(value) > 0
	}
	return true // If no accepted DB, assume accepted
}

func (i *CChainImporter) handleCorethConsensus(block *types.Block, receipts types.Receipts, usedGas uint64) {
	// Handle Coreth-specific consensus requirements
	// This includes Avalanche consensus integration

	// Mark block as verified by consensus
	i.markBlockAccepted(block)

	// Update consensus metrics
	if i.acceptedBlockDB != nil {
		key := []byte(fmt.Sprintf("consensus:%d", block.NumberU64()))
		value := []byte(fmt.Sprintf("gas:%d,txs:%d", usedGas, len(receipts)))
		i.acceptedBlockDB.Put(key, value)
	}
}