// SubnetEVMExporter exports data from a SubnetEVM database
type SubnetEVMExporter struct {
	config    ExporterConfig
	db        Database // Generic database interface
	namespace []byte
	chainInfo *ChainInfo
}

// Database is a generic interface for different database backends
type Database interface {
	Get(key []byte) ([]byte, error)
	Has(key []byte) (bool, error)
	NewIterator(prefix []byte, start []byte) Iterator
	Close() error
}

// Iterator is a generic database iterator
type Iterator interface {
	Next() bool
	Key() []byte
	Value() []byte
	Error() error
	Release()
}

// NewSubnetEVMExporter creates a new SubnetEVM exporter
func NewSubnetEVMExporter(config ExporterConfig) *SubnetEVMExporter {
	return &SubnetEVMExporter{
		config: config,
	}
}

// Init initializes the exporter with the source database
func (e *SubnetEVMExporter) Init(config ExporterConfig) error {
	e.config = config
	
	// Set default namespace if not provided
	if len(config.SubnetNamespace) == 0 {
		// Default SubnetEVM namespace for network 96369
		e.namespace, _ = hex.DecodeString("337fb73f9bcdac8c31a2d5f7b877ab1e8a2b7f2a1e9bf02a0a0e6c6fd164f1d1")
	} else {
		e.namespace = config.SubnetNamespace
	}
	
	// Open database based on type
	var err error
	switch config.DatabaseType {
	case "pebble":
		e.db, err = openPebbleDB(config.DatabasePath)
	case "badger":
		e.db, err = openBadgerDB(config.DatabasePath)
	case "leveldb":
		e.db, err = openLevelDB(config.DatabasePath)
	default:
		return fmt.Errorf("unsupported database type: %s", config.DatabaseType)
	}
	
	if err != nil {
		return fmt.Errorf("failed to open database: %w", err)
	}
	
	// Load chain info
	e.chainInfo, err = e.loadChainInfo()
	if err != nil {
		return fmt.Errorf("failed to load chain info: %w", err)
	}
	
	return nil
}

// GetChainInfo returns metadata about the chain
func (e *SubnetEVMExporter) GetChainInfo() (*ChainInfo, error) {
	if e.chainInfo == nil {
		return nil, fmt.Errorf("chain info not loaded")
	}
	return e.chainInfo, nil
}

// ExportBlocks exports blocks in the specified range
func (e *SubnetEVMExporter) ExportBlocks(ctx context.Context, start, end uint64) (<-chan *BlockData, <-chan error) {
	blockChan := make(chan *BlockData, 100)
	errChan := make(chan error, 1)
	
	go func() {
		defer close(blockChan)
		defer close(errChan)
		
		for num := start; num <= end; num++ {
			select {
			case <-ctx.Done():
				errChan <- ctx.Err()
				return
			default:
			}
			
			block, err := e.getBlock(num)
			if err != nil {
				if e.config.ContinueOnError {
					// Log error but continue
					fmt.Printf("Warning: failed to get block %d: %v\n", num, err)
					continue
				}
				errChan <- fmt.Errorf("failed to get block %d: %w", num, err)
				return
			}
			
			blockChan <- block
		}
	}()
	
	return blockChan, errChan
}

// getBlock retrieves a single block by number
func (e *SubnetEVMExporter) getBlock(number uint64) (*BlockData, error) {
	// First get the canonical hash for this block number
	hash, err := e.getCanonicalHash(number)
	if err != nil {
		return nil, fmt.Errorf("failed to get canonical hash: %w", err)
	}
	
	block := &BlockData{
		Number: number,
		Hash:   common.BytesToHash(hash),
		Extensions: make(map[string]interface{}),
	}
	
	// Get header
	headerKey := e.makeKey('h', number, hash)
	headerData, err := e.db.Get(headerKey)
	if err == nil && len(headerData) > 0 {
		block.Header = headerData
		
		// Decode header to extract fields
		var header types.Header
		if err := rlp.DecodeBytes(headerData, &header); err == nil {
			block.ParentHash = header.ParentHash
			block.Timestamp = header.Time
			block.StateRoot = header.Root
			block.ReceiptsRoot = header.ReceiptHash
			block.TransactionsRoot = header.TxHash
			block.GasLimit = header.GasLimit
			block.GasUsed = header.GasUsed
			block.Difficulty = header.Difficulty
			block.Coinbase = header.Coinbase
			block.Nonce = header.Nonce
			block.MixHash = header.MixDigest
			block.ExtraData = header.Extra
			block.BaseFee = header.BaseFee
		}
	}
	
	// Get body
	bodyKey := e.makeKey('b', number, hash)
	bodyData, err := e.db.Get(bodyKey)
	if err == nil && len(bodyData) > 0 {
		block.Body = bodyData
		
		// Decode transactions if needed
		if e.config.ExportState {
			var body types.Body
			if err := rlp.DecodeBytes(bodyData, &body); err == nil {
				block.Transactions = make([]*Transaction, len(body.Transactions))
				for i, tx := range body.Transactions {
					block.Transactions[i] = convertTransaction(tx)
				}
				
				// Convert uncle headers
				block.UncleHeaders = make([][]byte, len(body.Uncles))
				for i, uncle := range body.Uncles {
					block.UncleHeaders[i], _ = rlp.EncodeToBytes(uncle)
				}
			}
		}
	}
	
	// Get receipts
	if e.config.ExportReceipts {
		receiptsKey := e.makeKey('r', number, hash)
		receiptsData, err := e.db.Get(receiptsKey)
		if err == nil && len(receiptsData) > 0 {
			block.Receipts = receiptsData
			
			// Decode and attach to transactions
			var receipts types.Receipts
			if err := rlp.DecodeBytes(receiptsData, &receipts); err == nil {
				for i, receipt := range receipts {
					if i < len(block.Transactions) {
						block.Transactions[i].Receipt = convertReceipt(receipt)
					}
				}
			}
		}
	}
	
	// Get total difficulty if available
	tdKey := e.makeKey('t', number, hash)
	tdData, err := e.db.Get(tdKey)
	if err == nil && len(tdData) > 0 {
		block.TotalDifficulty = new(big.Int).SetBytes(tdData)
	}
	
	return block, nil
}

// getCanonicalHash gets the canonical block hash for a number
func (e *SubnetEVMExporter) getCanonicalHash(number uint64) ([]byte, error) {
	// Try canonical mapping first (namespace + 'h' + number + '6e')
	key := append([]byte(nil), e.namespace...)
	key = append(key, 'h')
	numBytes := make([]byte, 8)
	binary.BigEndian.PutUint64(numBytes, number)
	key = append(key, numBytes...)
	key = append(key, 0x6e) // Canonical suffix
	
	hash, err := e.db.Get(key)
	if err == nil && len(hash) == 32 {
		return hash, nil
	}
	
	// Try alternative canonical mapping (namespace + 'n' + number)
	key = append([]byte(nil), e.namespace...)
	key = append(key, 'n')
	key = append(key, numBytes...)
	
	hash, err = e.db.Get(key)
	if err == nil && len(hash) == 32 {
		return hash, nil
	}
	
	return nil, fmt.Errorf("canonical hash not found for block %d", number)
}

// makeKey creates a database key
func (e *SubnetEVMExporter) makeKey(prefix byte, number uint64, hash []byte) []byte {
	key := append([]byte(nil), e.namespace...)
	key = append(key, prefix)
	numBytes := make([]byte, 8)
	binary.BigEndian.PutUint64(numBytes, number)
	key = append(key, numBytes...)
	key = append(key, hash...)
	return key
}

// ExportState exports state at a specific block
func (e *SubnetEVMExporter) ExportState(ctx context.Context, blockNumber uint64) (<-chan *StateAccount, <-chan error) {
	stateChan := make(chan *StateAccount, 100)
	errChan := make(chan error, 1)
	
	go func() {
		defer close(stateChan)
		defer close(errChan)
		
		// Get state root at block
		block, err := e.getBlock(blockNumber)
		if err != nil {
			errChan <- fmt.Errorf("failed to get block for state: %w", err)
			return
		}
		
		// Iterate through state trie
		prefix := append([]byte(nil), e.namespace...)
		prefix = append(prefix, 0x00) // State trie prefix
		
		iter := e.db.NewIterator(prefix, nil)
		defer iter.Release()
		
		for iter.Next() {
			select {
			case <-ctx.Done():
				errChan <- ctx.Err()
				return
			default:
			}
			
			// Decode state account
			account, err := e.decodeStateAccount(iter.Key(), iter.Value(), block.StateRoot)
			if err != nil {
				continue // Skip invalid entries
			}
			
			stateChan <- account
		}
		
		if err := iter.Error(); err != nil {
			errChan <- fmt.Errorf("iterator error: %w", err)
		}
	}()
	
	return stateChan, errChan
}

// ExportAccount exports a specific account's state
func (e *SubnetEVMExporter) ExportAccount(ctx context.Context, address common.Address, blockNumber uint64) (*StateAccount, error) {
	// Get block for state root
	block, err := e.getBlock(blockNumber)
	if err != nil {
		return nil, fmt.Errorf("failed to get block: %w", err)
	}
	
	// Look up account in state trie
	accountKey := append([]byte(nil), e.namespace...)
	accountKey = append(accountKey, address.Bytes()...)
	
	accountData, err := e.db.Get(accountKey)
	if err != nil {
		return nil, fmt.Errorf("account not found: %w", err)
	}
	
	return e.decodeStateAccount(accountKey, accountData, block.StateRoot)
}

// decodeStateAccount decodes a state account from database
func (e *SubnetEVMExporter) decodeStateAccount(key, value []byte, stateRoot common.Hash) (*StateAccount, error) {
	// This is a simplified version - actual implementation would need
	// to properly decode the MPT state trie entries
	
	account := &StateAccount{
		Storage: make(map[common.Hash]common.Hash),
	}
	
	// Extract address from key if possible
	if len(key) >= 52 { // namespace(32) + address(20)
		copy(account.Address[:], key[32:52])
	}
	
	// The value contains encoded account data
	// In reality, we'd need to RLP decode the account structure
	
	return account, nil
}

// ExportConfig exports the chain configuration
func (e *SubnetEVMExporter) ExportConfig() (*ChainConfig, error) {
	config := &ChainConfig{
		NetworkID:   e.chainInfo.NetworkID,
		ChainID:     e.chainInfo.ChainID,
		Precompiles: make(map[common.Address]string),
	}
	
	// Get genesis block
	genesis, err := e.getBlock(0)
	if err == nil {
		config.GenesisBlock = genesis
	}
	
	// Set fork blocks based on known SubnetEVM configuration
	config.HomesteadBlock = big.NewInt(0)
	config.EIP150Block = big.NewInt(0)
	config.EIP155Block = big.NewInt(0)
	config.EIP158Block = big.NewInt(0)
	config.ByzantiumBlock = big.NewInt(0)
	config.ConstantinopleBlock = big.NewInt(0)
	config.PetersburgBlock = big.NewInt(0)
	config.IstanbulBlock = big.NewInt(0)
	config.BerlinBlock = big.NewInt(0)
	config.LondonBlock = big.NewInt(0)
	
	// SubnetEVM specific
	config.HasSubnetID = true
	config.SubnetID = e.config.SubnetID
	
	return config, nil
}

// VerifyExport verifies the integrity of exported data
func (e *SubnetEVMExporter) VerifyExport(blockNumber uint64) error {
	// Verify we can get the block
	block, err := e.getBlock(blockNumber)
	if err != nil {
		return fmt.Errorf("failed to get block for verification: %w", err)
	}
	
	// Verify parent chain
	if blockNumber > 0 {
		parent, err := e.getBlock(blockNumber - 1)
		if err != nil {
			return fmt.Errorf("failed to get parent block: %w", err)
		}
		
		if block.ParentHash != parent.Hash {
			return fmt.Errorf("parent hash mismatch at block %d", blockNumber)
		}
	}
	
	return nil
}

// loadChainInfo loads chain metadata
func (e *SubnetEVMExporter) loadChainInfo() (*ChainInfo, error) {
	info := &ChainInfo{
		ChainType:    ChainTypeSubnetEVM,
		NetworkID:    96369, // Default for Lux SubnetEVM
		ChainID:      big.NewInt(96369),
		DatabaseType: e.config.DatabaseType,
	}
	
	// Get latest block to determine height
	// Look for AcceptorTipKey
	tipKey := append([]byte(nil), e.namespace...)
	tipKey = append(tipKey, []byte("AcceptorTipKey")...)
	
	if tipHash, err := e.db.Get(tipKey); err == nil && len(tipHash) == 32 {
		// Get the block number for this hash
		hashKey := append([]byte(nil), e.namespace...)
		hashKey = append(hashKey, 'H')
		hashKey = append(hashKey, tipHash...)
		
		if numData, err := e.db.Get(hashKey); err == nil && len(numData) == 8 {
			info.CurrentHeight = binary.BigEndian.Uint64(numData)
		}
	}
	
	// Check if database is pruned
	// Try to get block 1000 - if we can't get its body, it's likely pruned
	if info.CurrentHeight > 1000 {
		if block, err := e.getBlock(1000); err == nil {
			info.IsPruned = len(block.Body) == 0
			info.ArchiveMode = !info.IsPruned
		}
	}
	
	return info, nil
}

// Close closes the exporter
func (e *SubnetEVMExporter) Close() error {
	if e.db != nil {
		return e.db.Close()
	}
	return nil
}

// Helper functions to convert Ethereum types to our generic types

func convertTransaction(tx *types.Transaction) *Transaction {
	v, r, s := tx.RawSignatureValues()
	
	result := &Transaction{
		Hash:      tx.Hash(),
		Nonce:     tx.Nonce(),
		Value:     tx.Value(),
		Gas:       tx.Gas(),
		GasPrice:  tx.GasPrice(),
		Data:      tx.Data(),
		V:         v,
		R:         r,
		S:         s,
		GasTipCap: tx.GasTipCap(),
		GasFeeCap: tx.GasFeeCap(),
	}
	
	if tx.To() != nil {
		result.To = tx.To()
	}
	
	if tx.AccessList() != nil {
		result.AccessList = tx.AccessList()
	}
	
	return result
}

func convertReceipt(receipt *types.Receipt) *TransactionReceipt {
	return &TransactionReceipt{
		Status:            receipt.Status,
		CumulativeGasUsed: receipt.CumulativeGasUsed,
		Bloom:             receipt.Bloom,
		Logs:              receipt.Logs,
		TransactionHash:   receipt.TxHash,
		ContractAddress:   receipt.ContractAddress,
		GasUsed:           receipt.GasUsed,
	}
}

// Database wrapper implementations

type pebbleDB struct {
	db *pebble.DB
}

func openPebbleDB(path string) (Database, error) {
	db, err := pebble.Open(path, &pebble.Options{ReadOnly: true})
	if err != nil {
		return nil, err
	}
	return &pebbleDB{db: db}, nil
}

func (p *pebbleDB) Get(key []byte) ([]byte, error) {
	value, closer, err := p.db.Get(key)
	if err != nil {
		return nil, err
	}
	defer closer.Close()
	
	// Copy value since it's only valid until closer is called
	result := make([]byte, len(value))
	copy(result, value)
	return result, nil
}

func (p *pebbleDB) Has(key []byte) (bool, error) {
	_, closer, err := p.db.Get(key)
	if err == pebble.ErrNotFound {
		return false, nil
	}
	if err != nil {
		return false, err
	}
	closer.Close()
	return true, nil
}

func (p *pebbleDB) NewIterator(prefix []byte, start []byte) Iterator {
	opts := &pebble.IterOptions{
		LowerBound: prefix,
		UpperBound: append(prefix, 0xFF),
	}
	iter, _ := p.db.NewIter(opts)
	if start != nil {
		iter.SeekGE(start)
	} else {
		iter.First()
	}
	return &pebbleIterator{iter: iter}
}

func (p *pebbleDB) Close() error {
	return p.db.Close()
}

type pebbleIterator struct {
	iter *pebble.Iterator
}

func (i *pebbleIterator) Next() bool {
	return i.iter.Next()
}

func (i *pebbleIterator) Key() []byte {
	return i.iter.Key()
}

func (i *pebbleIterator) Value() []byte {
	return i.iter.Value()
}

func (i *pebbleIterator) Error() error {
	return i.iter.Error()
}

func (i *pebbleIterator) Release() {
	i.iter.Close()
}

// Similar wrappers for badgerDB and levelDB...

type badgerDB struct {
	db *badger.DB
}

func openBadgerDB(path string) (Database, error) {
	opts := badger.DefaultOptions(path).WithReadOnly(true).WithLogger(nil)
	db, err := badger.Open(opts)
	if err != nil {
		return nil, err
	}
	return &badgerDB{db: db}, nil
}

func (b *badgerDB) Get(key []byte) ([]byte, error) {
	var value []byte
	err := b.db.View(func(txn *badger.Txn) error {
		item, err := txn.Get(key)
		if err != nil {
			return err
		}
		value, err = item.ValueCopy(nil)
		return err
	})
	return value, err
}

func (b *badgerDB) Has(key []byte) (bool, error) {
	err := b.db.View(func(txn *badger.Txn) error {
		_, err := txn.Get(key)
		return err
	})
	if err == badger.ErrKeyNotFound {
		return false, nil
	}
	if err != nil {
		return false, err
	}
	return true, nil
}

func (b *badgerDB) NewIterator(prefix []byte, start []byte) Iterator {
	// Simplified - would need proper implementation
	return nil
}

func (b *badgerDB) Close() error {
	return b.db.Close()
}

type levelDB struct {
	db *leveldb.DB
}

func openLevelDB(path string) (Database, error) {
	db, err := leveldb.OpenFile(path, nil)
	if err != nil {
		return nil, err
	}
	return &levelDB{db: db}, nil
}

func (l *levelDB) Get(key []byte) ([]byte, error) {
	return l.db.Get(key, nil)
}

func (l *levelDB) Has(key []byte) (bool, error) {
	return l.db.Has(key, nil)
}

func (l *levelDB) NewIterator(prefix []byte, start []byte) Iterator {
	// Simplified - would need proper implementation
	return nil
}

func (l *levelDB) Close() error {
	return l.db.Close()
}