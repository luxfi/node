package chainmigrate

import (
	"context"
	"fmt"
	"sync"
	"time"

	"github.com/luxfi/geth/common"
)

// Migrator orchestrates the migration process between chains
type Migrator struct {
	exporter ChainExporter
	importer ChainImporter
	config   MigratorConfig

	// Progress tracking
	mu                sync.RWMutex
	totalBlocks      uint64
	processedBlocks  uint64
	totalAccounts    uint64
	processedAccounts uint64
	startTime        time.Time
	errors           []error
}

// MigratorConfig holds configuration for the migrator
type MigratorConfig struct {
	// Block range to migrate
	StartBlock uint64
	EndBlock   uint64

	// Batch sizes
	BlockBatchSize int
	StateBatchSize int

	// Processing options
	ParallelWorkers int
	ContinueOnError bool
	VerifyBlocks    bool
	VerifyState     bool

	// Progress reporting
	ProgressInterval time.Duration
	LogFunc          func(string, ...interface{})
}

// NewChainMigrator creates a new chain migrator
func NewChainMigrator(exporter ChainExporter, importer ChainImporter, config MigratorConfig) *Migrator {
	// Set defaults
	if config.BlockBatchSize == 0 {
		config.BlockBatchSize = 100
	}
	if config.StateBatchSize == 0 {
		config.StateBatchSize = 1000
	}
	if config.ParallelWorkers == 0 {
		config.ParallelWorkers = 4
	}
	if config.ProgressInterval == 0 {
		config.ProgressInterval = 10 * time.Second
	}
	if config.LogFunc == nil {
		config.LogFunc = func(format string, args ...interface{}) {
			fmt.Printf(format+"\n", args...)
		}
	}

	return &Migrator{
		exporter: exporter,
		importer: importer,
		config:   config,
	}
}

// Migrate performs the full migration process
func (m *Migrator) Migrate(ctx context.Context) error {
	m.startTime = time.Now()
	m.config.LogFunc("Starting chain migration from block %d to %d", m.config.StartBlock, m.config.EndBlock)

	// Initialize exporter and importer
	if err := m.exporter.Init(ExporterConfig{
		StartBlock:      m.config.StartBlock,
		EndBlock:        m.config.EndBlock,
		ContinueOnError: m.config.ContinueOnError,
	}); err != nil {
		return fmt.Errorf("failed to initialize exporter: %w", err)
	}

	if err := m.importer.Init(ImporterConfig{
		ContinueOnError: m.config.ContinueOnError,
	}); err != nil {
		return fmt.Errorf("failed to initialize importer: %w", err)
	}

	// Get chain info
	srcInfo, err := m.exporter.GetChainInfo()
	if err != nil {
		return fmt.Errorf("failed to get source chain info: %w", err)
	}

	m.config.LogFunc("Source chain: %s (ID: %d)", srcInfo.Name, srcInfo.ChainID)
	m.config.LogFunc("Latest block: %d", srcInfo.LatestBlock)

	// Export and import configuration
	chainConfig, err := m.exporter.ExportConfig()
	if err != nil {
		return fmt.Errorf("failed to export chain config: %w", err)
	}

	if err := m.importer.ImportConfig(chainConfig); err != nil {
		return fmt.Errorf("failed to import chain config: %w", err)
	}

	// Adjust block range if needed
	if m.config.EndBlock == 0 || m.config.EndBlock > srcInfo.LatestBlock {
		m.config.EndBlock = srcInfo.LatestBlock
	}

	m.totalBlocks = m.config.EndBlock - m.config.StartBlock + 1
	m.config.LogFunc("Migrating %d blocks", m.totalBlocks)

	// Start progress reporter
	progressCtx, cancelProgress := context.WithCancel(ctx)
	defer cancelProgress()
	go m.reportProgress(progressCtx)

	// Phase 1: Migrate blocks
	m.config.LogFunc("\n=== Phase 1: Migrating Blocks ===")
	if err := m.migrateBlocks(ctx); err != nil {
		return fmt.Errorf("block migration failed: %w", err)
	}

	// Phase 2: Migrate state (at end block)
	m.config.LogFunc("\n=== Phase 2: Migrating State ===")
	if err := m.migrateState(ctx, m.config.EndBlock); err != nil {
		return fmt.Errorf("state migration failed: %w", err)
	}

	// Phase 3: Finalize import
	m.config.LogFunc("\n=== Phase 3: Finalizing Import ===")
	if err := m.importer.FinalizeImport(m.config.EndBlock); err != nil {
		return fmt.Errorf("failed to finalize import: %w", err)
	}

	// Phase 4: Verification (optional)
	if m.config.VerifyBlocks || m.config.VerifyState {
		m.config.LogFunc("\n=== Phase 4: Verification ===")
		if err := m.verify(ctx); err != nil {
			return fmt.Errorf("verification failed: %w", err)
		}
	}

	// Report final stats
	m.reportFinalStats()

	return nil
}

// migrateBlocks migrates blocks in batches
func (m *Migrator) migrateBlocks(ctx context.Context) error {
	// Create channels for block streaming
	blockChan, errChan := m.exporter.ExportBlocks(ctx, m.config.StartBlock, m.config.EndBlock)

	// Process blocks in batches
	batch := make([]*BlockData, 0, m.config.BlockBatchSize)

	for {
		select {
		case <-ctx.Done():
			return ctx.Err()

		case err := <-errChan:
			if err != nil {
				m.recordError(err)
				if !m.config.ContinueOnError {
					return err
				}
			}

		case block, ok := <-blockChan:
			if !ok {
				// Channel closed, process remaining batch
				if len(batch) > 0 {
					if err := m.processBatch(batch); err != nil {
						return err
					}
				}
				return nil
			}

			batch = append(batch, block)

			if len(batch) >= m.config.BlockBatchSize {
				if err := m.processBatch(batch); err != nil {
					return err
				}
				batch = batch[:0]
			}
		}
	}
}

// processBatch processes a batch of blocks
func (m *Migrator) processBatch(blocks []*BlockData) error {
	// Import blocks
	if err := m.importer.ImportBlocks(blocks); err != nil {
		m.recordError(err)
		if !m.config.ContinueOnError {
			return err
		}
	}

	// Update progress
	m.mu.Lock()
	m.processedBlocks += uint64(len(blocks))
	m.mu.Unlock()

	return nil
}

// migrateState migrates state at a specific block
func (m *Migrator) migrateState(ctx context.Context, blockNumber uint64) error {
	// Stream state accounts
	accountChan, errChan := m.exporter.ExportState(ctx, blockNumber)

	batch := make([]*StateAccount, 0, m.config.StateBatchSize)
	totalAccounts := uint64(0)

	for {
		select {
		case <-ctx.Done():
			return ctx.Err()

		case err := <-errChan:
			if err != nil {
				m.recordError(err)
				if !m.config.ContinueOnError {
					return err
				}
			}

		case account, ok := <-accountChan:
			if !ok {
				// Channel closed, process remaining batch
				if len(batch) > 0 {
					if err := m.importer.ImportState(batch, blockNumber); err != nil {
						return err
					}
					totalAccounts += uint64(len(batch))
				}

				m.mu.Lock()
				m.totalAccounts = totalAccounts
				m.processedAccounts = totalAccounts
				m.mu.Unlock()

				m.config.LogFunc("Imported %d state accounts", totalAccounts)
				return nil
			}

			batch = append(batch, account)

			if len(batch) >= m.config.StateBatchSize {
				if err := m.importer.ImportState(batch, blockNumber); err != nil {
					m.recordError(err)
					if !m.config.ContinueOnError {
						return err
					}
				}
				totalAccounts += uint64(len(batch))
				batch = batch[:0]

				// Update progress
				m.mu.Lock()
				m.processedAccounts = totalAccounts
				m.mu.Unlock()
			}
		}
	}
}

// verify performs verification of the migrated data
func (m *Migrator) verify(ctx context.Context) error {
	if m.config.VerifyBlocks {
		m.config.LogFunc("Verifying blocks...")

		// Sample verification - check every 100th block
		for blockNum := m.config.StartBlock; blockNum <= m.config.EndBlock; blockNum += 100 {
			select {
			case <-ctx.Done():
				return ctx.Err()
			default:
			}

			if err := m.exporter.VerifyExport(blockNum); err != nil {
				return fmt.Errorf("export verification failed at block %d: %w", blockNum, err)
			}

			if err := m.importer.VerifyImport(blockNum); err != nil {
				return fmt.Errorf("import verification failed at block %d: %w", blockNum, err)
			}
		}

		m.config.LogFunc("Block verification passed")
	}

	if m.config.VerifyState {
		m.config.LogFunc("Verifying state at block %d...", m.config.EndBlock)

		if err := m.importer.VerifyImport(m.config.EndBlock); err != nil {
			return fmt.Errorf("state verification failed: %w", err)
		}

		m.config.LogFunc("State verification passed")
	}

	return nil
}

// reportProgress reports migration progress periodically
func (m *Migrator) reportProgress(ctx context.Context) {
	ticker := time.NewTicker(m.config.ProgressInterval)
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			m.mu.RLock()
			blocks := m.processedBlocks
			totalBlocks := m.totalBlocks
			accounts := m.processedAccounts
			totalAccounts := m.totalAccounts
			m.mu.RUnlock()

			elapsed := time.Since(m.startTime)

			if totalBlocks > 0 {
				blockProgress := float64(blocks) / float64(totalBlocks) * 100
				blocksPerSec := float64(blocks) / elapsed.Seconds()

				eta := time.Duration(0)
				if blocksPerSec > 0 {
					remainingBlocks := totalBlocks - blocks
					eta = time.Duration(float64(remainingBlocks)/blocksPerSec) * time.Second
				}

				m.config.LogFunc(
					"Progress: Blocks %d/%d (%.1f%%), Accounts %d/%d, Speed: %.1f blocks/s, ETA: %s",
					blocks, totalBlocks, blockProgress,
					accounts, totalAccounts,
					blocksPerSec,
					eta.Round(time.Second),
				)
			}
		}
	}
}

// reportFinalStats reports final migration statistics
func (m *Migrator) reportFinalStats() {
	elapsed := time.Since(m.startTime)

	m.mu.RLock()
	blocks := m.processedBlocks
	accounts := m.processedAccounts
	errorCount := len(m.errors)
	m.mu.RUnlock()

	m.config.LogFunc("\n=== Migration Complete ===")
	m.config.LogFunc("Total time: %s", elapsed.Round(time.Second))
	m.config.LogFunc("Blocks migrated: %d", blocks)
	m.config.LogFunc("State accounts migrated: %d", accounts)

	if blocks > 0 {
		blocksPerSec := float64(blocks) / elapsed.Seconds()
		m.config.LogFunc("Average speed: %.1f blocks/s", blocksPerSec)
	}

	if errorCount > 0 {
		m.config.LogFunc("Errors encountered: %d", errorCount)
		if errorCount <= 10 {
			for i, err := range m.errors {
				m.config.LogFunc("  Error %d: %v", i+1, err)
			}
		} else {
			m.config.LogFunc("  (showing first 10 errors)")
			for i := 0; i < 10; i++ {
				m.config.LogFunc("  Error %d: %v", i+1, m.errors[i])
			}
		}
	} else {
		m.config.LogFunc("No errors encountered")
	}
}

// recordError records an error
func (m *Migrator) recordError(err error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.errors = append(m.errors, err)
}

// Close closes the migrator and its components
func (m *Migrator) Close() error {
	var errs []error

	if err := m.exporter.Close(); err != nil {
		errs = append(errs, fmt.Errorf("failed to close exporter: %w", err))
	}

	if err := m.importer.Close(); err != nil {
		errs = append(errs, fmt.Errorf("failed to close importer: %w", err))
	}

	if len(errs) > 0 {
		return fmt.Errorf("close errors: %v", errs)
	}

	return nil
}