[Unit]
Description=LUX Network Node (C-Chain)
After=network.target
Documentation=https://docs.lux.network

[Service]
Type=simple
User=z
WorkingDirectory=/home/z/work/lux/node
ExecStart=/home/z/work/lux/node/build/luxd \
    --network-id=96369 \
    --http-host=127.0.0.1 \
    --http-port=9630 \
    --staking-port=9631 \
    --db-dir=/home/z/work/lux/.luxd-single \
    --dev \
    --log-level=info

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=luxd

# Resource limits
LimitNOFILE=32768
LimitNPROC=4096

[Install]
WantedBy=multi-user.target